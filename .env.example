# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/telebackend

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_TOKEN=admin-session-token

# Rootments External APIs & Sync Tokens
ROOTMENTS_API_TOKEN=your-rootments-bearer-token-for-employee-verification
ROOTMENTS_VERIFY_API=https://rootments.in/api/verify_employee
BOOKING_SUMMARY_URL=https://rentalapi.rootments.live/api/GetBooking/GetBookingSummary
RETURN_REPORT_URL=https://rentalapi.rootments.live/api/Reports/GetReturnReport
STORE_LIST_API=https://rentalapi.rootments.live/api/Location/LocationList

# JustDial Integration
JUSTDIAL_API_URL=https://api.justdial.com/v1/leads
JUSTDIAL_SECRET=your-justdial-webhook-secret-token

# Webhooks & Meta Graph Integration
CUSTOM_WEBHOOK_API_KEY=your-custom-webhook-key
META_WEBHOOK_VERIFY_TOKEN=your-meta-verify-token
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# Multi-Brand WhatsApp Phone IDs
WA_PHONE_ID_ZORUCCI=your-zorucci-phone-number-id
WA_PHONE_ID_SUITOR_GUY=your-suitorguy-phone-number-id
WA_PHONE_ID_DAPPER_SQUAD=your-dappersquad-phone-number-id

# Multi-Brand Instagram Business IDs
IG_ACCOUNT_ID_ZORUCCI=your-zorucci-ig-account-id
IG_ACCOUNT_ID_SUITOR_GUY=your-suitorguy-ig-account-id
IG_ACCOUNT_ID_DAPPER_SQUAD=your-dappersquad-ig-account-id

# Multi-Brand Facebook Page IDs
FB_PAGE_ID_ZORUCCI=your-zorucci-fb-page-id
FB_PAGE_ID_SUITOR_GUY=your-suitorguy-fb-page-id
FB_PAGE_ID_DAPPER_SQUAD=your-dappersquad-fb-page-id

